---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Add the published Apps Script /exec URL before merging this draft.
const counterUrl = '';
---

<BaseLayout
  title="Mandatsreferenzen — Elements Jiu-Jitsu"
  description="Interne Bedienseite zur Vergabe von Mandatsreferenzen."
  noindex
  hideStickyCta
>
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:py-24">
    <div class="rounded-2xl border border-border bg-card p-6 shadow-xl sm:p-10">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary">Interne Verwaltung</p>
      <h1 class="font-display mt-3 text-3xl font-bold uppercase sm:text-4xl">
        Mandatsreferenzen
      </h1>
      <p class="mt-4 max-w-2xl text-muted-foreground">
        Wähle den Standort in der zentralen Vergabeseite. Reservierte Referenzen werden dort
        geräteübergreifend gespeichert.
      </p>

      {counterUrl ? (
        <a
          href={counterUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="gradient-neon mt-8 inline-flex min-h-16 w-full items-center justify-center rounded-xl px-6 py-5 text-center text-lg font-bold text-primary-foreground transition-smooth hover:opacity-90 sm:w-auto sm:min-w-80"
        >
          Mandatsreferenzverwaltung öffnen
        </a>
      ) : (
        <p class="mt-8 rounded-xl border border-border bg-background px-5 py-4 font-medium text-muted-foreground">
          Die zentrale Bedienseite wird nach der Freigabe hier verknüpft.
        </p>
      )}

      <p class="mt-6 text-sm text-muted-foreground">
        Die Bedienseite öffnet in einem eigenen Tab. Für den Zugriff muss dein Google-Konto für
        die zentrale Tabelle freigegeben sein.
      </p>
    </div>
  </section>
</BaseLayout>
